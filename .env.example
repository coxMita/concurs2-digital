# ============================================================================
#  Concurs - configuration.  Copy to .env:   cp .env.example .env
#  Works as-is. Usually the only value to change is DOMAIN.
# ============================================================================

# Public domain of the site, e.g. teste.liceul-meu.ro
#   localhost  -> HTTPS with Caddy's internal self-signed certificate (testing:
#                 open https://localhost on the server itself).
#   real name  -> free Let's Encrypt certificate, obtained automatically.
#                 Point the domain's DNS (A record) to this server first and
#                 keep ports 80 and 443 open.
DOMAIN=localhost

# Protects the one-time /setup page that creates the first admin account.
# Leave empty: on the first `docker compose up` a random token is generated and
# written here. It is also printed in the logs with the /setup link:
#   docker compose logs app
SETUP_TOKEN=

# PostgreSQL credentials. The database is NOT exposed outside Docker.
# Leave POSTGRES_PASSWORD empty: on the first `docker compose up` a random
# password is generated and written here. Do not change it afterwards: the
# database keeps the password it was created with.
POSTGRES_USER=concurs
POSTGRES_PASSWORD=
POSTGRES_DB=concurs

# --- Optional tuning (defaults suit 500 students on 2 vCPU / 4 GB) ----------
# Database connections used by the app.
DB_MAX_CONNECTIONS=25
# Maximum size of an uploaded question image, in MB.
MAX_UPLOAD_MB=3
# Secure cookies (HTTPS only). Keep true behind Caddy.
COOKIE_SECURE=true
# Log level: error, warn, info, debug
RUST_LOG=info,sqlx=warn,tower_http=warn

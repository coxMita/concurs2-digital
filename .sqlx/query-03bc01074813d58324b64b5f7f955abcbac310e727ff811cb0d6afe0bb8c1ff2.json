  "query": "SELECT s.id, s.full_name, s.username, s.extra_minutes,\n                  a.started_at AS \"started_at?\", a.submitted_at, a.percentage\n           FROM students s LEFT JOIN attempts a ON a.student_id = s.id\n           WHERE s.exam_id = $1\n           ORDER BY s.created_at, s.username",
